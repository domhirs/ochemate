# Copy to .env (docker compose reads it automatically).

# Custom voice recordings: "on" lets anyone who can reach the server upload and delete voices (fine on a LAN).
# "off" makes the voice API read-only. Set it to off for a public deployment, because there is no authentication.
VOICE_UPLOADS=on

# Data import (Settings > Data): "on" lets anyone who can reach the server replace all players and matches with an
# uploaded file. "off" disables it (export still works). Set it to off for a public deployment.
DATA_IMPORT=on

# Image tag to run: a release such as 0.1.0 (recommended), or latest (newest release).
# OCHEMATE_TAG=latest

# Host port of the web UI. Set a different one for a second instance on the same Docker host.
# OCHEMATE_PORT=8080
